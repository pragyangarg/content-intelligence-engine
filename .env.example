# Content Intelligence Engine Configuration

# RSS Ingestion
RSS_FEED_URL=https://techcrunch.com/feed/
SCHEDULER_INTERVAL=300

# Relational Storage
DATABASE_URL=sqlite:///./content.db

# Embedding & Vector Database
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=articles

# Optional LLM Provider (falls back to local grounded synthesis if not set)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional Transformer Pipeline flag for local summarizer/sentiment models
ENABLE_TRANSFORMER_MODELS=false

